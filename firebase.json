{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "web/dist",
    "predeploy": ["npm --prefix web run build"],
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [
      { "source": "/new", "destination": "/index.html" },
      { "source": "/4cb", "destination": "/index.html" },
      { "source": "/4cb/rules", "destination": "/index.html" },
      { "source": "/dashboard", "destination": "/index.html" },
      { "source": "/contact", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" },
      {
        "source": "/api/rd/fetchCube",
        "function": {
          "functionId": "rdFetchCube",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/ping",
        "function": {
          "functionId": "rdPing",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/contact",
        "function": {
          "functionId": "rdContact",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/sets",
        "function": {
          "functionId": "rdSets",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/claim",
        "function": {
          "functionId": "rdClaim",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/pick",
        "function": {
          "functionId": "rdPick",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/inbox",
        "function": {
          "functionId": "rdInbox",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/rd/staples",
        "function": {
          "functionId": "rdStaples",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cb/claim",
        "function": {
          "functionId": "cbClaim",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cb/submit",
        "function": {
          "functionId": "cbSubmit",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cb/round",
        "function": {
          "functionId": "cbRound",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cb/report",
        "function": {
          "functionId": "cbReport",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cb/chat",
        "function": {
          "functionId": "cbChat",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      }
    ]
  }
}
