rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rotisserie Draft — hardened rules.
    //
    // Public (observer mode needs this): single-document reads of a
    // draft and its card pool. Everything else is locked down:
    // - listing drafts: site owner only (links stay unguessable)
    // - admin actions: the creator's auth uid (adminUid), or the owner
    // - seat data (queue, sideboard, push subs, rejoin secret): only
    //   auth uids bound to that seat (bound at join or via rdClaim)
    // - chat: bound players only
    // - picks: never writable by clients — only the rdPick function
    //   and the draft engine trigger (Admin SDK bypasses rules)

    function isOwner() {
      return request.auth != null && request.auth.uid == 'hnNb04iTrEQmsT8OJttKYo10JHd2';
    }
    function draftData(draftId) {
      return get(/databases/$(database)/documents/rd-drafts/$(draftId)).data;
    }
    function isDraftAdmin(draftId) {
      return request.auth != null &&
        (request.auth.uid == draftData(draftId).adminUid || isOwner());
    }
    function isArchived(draftId) {
      return draftData(draftId).get('archived', false) == true;
    }

    match /rd-drafts/{draftId} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.adminUid || isOwner());
      allow update: if
        // Admin: anything except the pick log (server-only)
        (request.auth != null
          && (request.auth.uid == resource.data.adminUid || isOwner())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['picks', 'adminUid']))
        ||
        // Self-service join/leave in the lobby: may only touch the own
        // uid binding and the own player entry, within the seat cap
        (request.auth != null
          && resource.data.status == 'lobby'
          && resource.data.get('archived', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'uids'])
          && request.resource.data.get('uids', {}).diff(resource.data.get('uids', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
               .hasOnly([resource.data.get('uids', {}).get(request.auth.uid, '-'),
                         request.resource.data.get('uids', {}).get(request.auth.uid, '-')])
          && request.resource.data.players.size() <= resource.data.settings.players);
    }

    // Card pool (and other meta): public read, admin write
    match /rd-drafts/{draftId}/meta/{docId} {
      allow read: if true;
      allow write: if isDraftAdmin(draftId);
    }

    // Per-seat private data. The `uids` allowlist is written at join
    // and extended only by the rdClaim function (Admin SDK).
    match /rd-drafts/{draftId}/private/{pid} {
      allow read: if request.auth != null
        && (resource.data.get('uids', {}).get(request.auth.uid, false) == true
            || isDraftAdmin(draftId));
      allow create: if request.auth != null
        && (request.resource.data.get('uids', {}).get(request.auth.uid, false) == true
            || isDraftAdmin(draftId));
      allow update: if request.auth != null
        && resource.data.get('uids', {}).get(request.auth.uid, false) == true
        && !isArchived(draftId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['queue', 'sideboard', 'pushSubs']);
      allow delete: if request.auth != null
        && (resource.data.get('uids', {}).get(request.auth.uid, false) == true
            || isDraftAdmin(draftId));
    }

    // Chat: bound players only
    match /rd-drafts/{draftId}/chat/{msgId} {
      allow read: if request.auth != null
        && request.auth.uid in draftData(draftId).get('uids', {});
      allow create: if request.auth != null
        && !isArchived(draftId)
        && draftData(draftId).get('uids', {}).get(request.auth.uid, '') == request.resource.data.pid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly(['pid', 'name', 'text', 'at']);
      allow update: if false;
      allow delete: if isDraftAdmin(draftId);
    }

    // Scryfall set catalog cache: written only by the rdSets function
    match /rd-meta/{docId} {
      allow read, write: if false;
    }

    // Per-user draft membership index for the dashboard
    match /rd-users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Contact messages: written only by the rdContact function and read
    // only through the rdInbox function (admin SDK bypasses rules)
    match /rd-contact/{msgId} {
      allow read, write: if false;
    }
  }
}
